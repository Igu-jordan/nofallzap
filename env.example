# ============================================================
# NoFallZap — variaveis de ambiente
# Copie para .env (local) ou cole no painel do EasyPanel.
# ============================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------- banco e fila
# No EasyPanel, o host e o nome do servico na rede interna.
DATABASE_URL=postgresql://nofallzap:TROQUE_ESTA_SENHA@maturador_postgres:5432/nofallzap
REDIS_URL=redis://maturador_redis:6379

# ---------------------------------------------- Evolution API
# Se a Evolution esta no MESMO projeto do EasyPanel, use o DNS interno
# (mais rapido e nao passa pela internet). Confirme o nome do servico
# no painel: normalmente e <projeto>_<servico>.
EVOLUTION_BASE_URL=http://maturador_evolution-api:8080
EVOLUTION_GLOBAL_KEY=COLE_AQUI_A_APIKEY_GLOBAL_DA_EVOLUTION

# ---------------------------------------------- webhook
# URL que a Evolution vai chamar a cada evento. Rede interna e o ideal:
# nao expoe o webhook para a internet.
WEBHOOK_PUBLIC_URL=http://maturador_nofallzap-api:3000/webhook/evolution
# Segredo que a API valida no header x-webhook-secret. Gere um aleatorio:
#   openssl rand -hex 24
WEBHOOK_SHARED_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO

# ---------------------------------------------- painel
PANEL_USER=admin
PANEL_PASSWORD=TROQUE_ESTA_SENHA
SESSION_SECRET=TROQUE_POR_UMA_STRING_LONGA_E_ALEATORIA

# ---------------------------------------------- ritmo de envio
# Usado pela fila de envio (fase da IA). Intervalo entre mensagens do MESMO
# numero, com variacao aleatoria — parte da maturacao do chip.
SEND_MIN_DELAY_MS=3000
SEND_MAX_DELAY_MS=9000
SEND_RATE_PER_MINUTE=12

# Janela de agrupamento por grupo antes de acionar a IA.
# 5 mensagens em rajada viram 1 processamento em vez de 5.
GROUP_DEBOUNCE_MS=10000

# ---------------------------------------------- operacao
HEALTHCHECK_INTERVAL_MS=60000
WORKER_CONCURRENCY=20
LOG_LEVEL=info

# ---------------------------------------------- IA (fase 5)
AI_PROVIDER=openai
# Sem esta chave a IA nao responde nada (o resto do painel funciona normal).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
# Quantas mensagens recentes vao no contexto enviado ao modelo.
AI_CONTEXT_MESSAGES=20
# A partir de quantas mensagens novas o grupo ganha um resumo de memoria.
AI_MEMORY_THRESHOLD=60
# Teto de mensagens novas processadas de uma vez por grupo.
AI_BATCH_LIMIT=30
