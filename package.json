{
  "name": "nofallzap",
  "version": "0.1.0",
  "private": true,
  "description": "Painel multi-instancia de WhatsApp sobre Evolution API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "teste:auth": "npm run build:server && node scripts/teste-auth.mjs",
    "teste:risco": "npm run build:server && node scripts/teste-risco.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.6",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "prisma": "^6.2.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
