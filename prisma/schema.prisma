// NoFallZap - painel multi-instancia de WhatsApp sobre Evolution API
// Regra de ouro: nada existe fora de uma instancia. instance_id em tudo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstanceStatus {
  creating
  awaiting_qr
  connecting
  connected
  disconnected
  reconnecting
  error
}

enum ParticipationMode {
  mention // so responde quando mencionado
  always // responde toda mensagem
  keyword // responde quando bater palavra-chave
  smart // motor de decisao resolve (custa mais IA)
}

model Instance {
  id       String @id @default(uuid())
  name     String // nome interno: "WhatsApp Suporte"
  /// instanceName na Evolution API (slug unico)
  evoName  String @unique @map("evolution_name")
  /// hash retornado no /instance/create
  evoToken String? @map("evolution_token")
  /// para quando houver mais de um container da Evolution
  evoServerId String @default("default") @map("evolution_server_id")

  phoneNumber   String? @map("phone_number")
  profileName   String? @map("profile_name")
  profilePicUrl String? @map("profile_pic_url")

  status       InstanceStatus @default(creating)
  statusDetail String?        @map("status_detail")

  /// pausa nivel INSTANCIA
  aiEnabled Boolean @default(false) @map("ai_enabled")

  // ---------------------------------------------------------------- RITMO
  // Uma pessoa nao fica grudada no WhatsApp 24h por dia. O ritmo vive na
  // INSTANCIA porque quem descansa e a pessoa (o numero), nao o papel: ela
  // larga o celular e some de todos os grupos ao mesmo tempo.
  rhythmEnabled Boolean @default(true) @map("rhythm_enabled")
  /// quanto tempo fica respondendo antes de "largar o celular"
  activeMinutes Int     @default(45) @map("active_minutes")
  /// quanto tempo fica fora antes de voltar
  pauseMinutes  Int     @default(90) @map("pause_minutes")
  /// estado atual do ciclo: active | paused
  rhythmState   String  @default("active") @map("rhythm_state")
  /// ate quando o estado atual vale
  rhythmUntil   DateTime? @map("rhythm_until")

  /// horario de funcionamento (hora local). Uma pessoa dorme.
  workStartHour Int    @default(8) @map("work_start_hour")
  workEndHour   Int    @default(22) @map("work_end_hour")
  timezone      String @default("America/Sao_Paulo")

  // ------------------------------------------------------------ MATURACAO
  /// este numero participa do aquecimento (conversa com os outros numeros)
  warmupEnabled   Boolean   @default(false) @map("warmup_enabled")
  warmupStartedAt DateTime? @map("warmup_started_at")
  /// quando este numero deve mandar a proxima mensagem de aquecimento
  nextWarmupAt    DateTime? @map("next_warmup_at")

  /// ultimo QR recebido (base64), limpo quando conecta
  lastQrBase64 String? @map("last_qr_base64")
  qrUpdatedAt  DateTime? @map("qr_updated_at")

  reconnectAttempts Int       @default(0) @map("reconnect_attempts")

  /// ENTREGA RECUSADA — o numero aparece conectado e o WhatsApp devolve
  /// status ERROR em tudo que ele manda. Conta apenas as mensagens que o
  /// PAINEL enviou: o que sai do celular entrega normal e mascararia o
  /// problema. Ao bater no limite o numero e desligado sozinho, para nao
  /// continuar gerando resposta com IA (que voce paga) e jogando no vazio.
  deliveryFailures  Int       @default(0) @map("delivery_failures")
  deliveryBlockedAt DateTime? @map("delivery_blocked_at")

  lastConnectedAt   DateTime? @map("last_connected_at")
  lastActivityAt    DateTime? @map("last_activity_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  groups   Group[]
  contacts Contact[]
  messages Message[]
  events   InstanceEvent[]
  metrics  MetricDaily[]
  /// destinos de rodizio que apontam para este numero
  rotatorDestinations RotatorDestination[]

  @@index([status])
  @@index([deletedAt])
  @@map("instances")
}

model Agent {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String   @map("system_prompt")
  model        String   @default("gpt-4o-mini")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(500) @map("max_tokens")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  groups Group[]
  /// grupos que usam este agente para atender no PRIVADO. E aqui que mora o
  /// que o grupo nao pode ver: preco, condicao, dado de cliente.
  dmGroups Group[]   @relation("GroupDmAgent")
  contacts Contact[]

  @@map("agents")
}

model Group {
  id         String   @id @default(uuid())
  instanceId String   @map("instance_id")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// 1203...@g.us — ID vindo da Evolution API
  remoteJid         String  @map("remote_jid")
  subject           String?
  description       String?
  pictureUrl        String? @map("picture_url")
  participantsCount Int     @default(0) @map("participants_count")
  isCommunity       Boolean @default(false) @map("is_community")

  /// PADRAO: DESLIGADO. Admin ativa grupo a grupo.
  aiEnabled Boolean @default(false) @map("ai_enabled")

  agentId String? @map("agent_id")
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  /// CHAMAR NO PRIVADO. Desligado por padrao, igual a IA do grupo: puxar
  /// alguem para o privado e uma acao com consequencia, entao e opt-in.
  escalationEnabled Boolean @default(false) @map("escalation_enabled")
  /// Quem atende no privado quando alguem sai deste grupo. Separado do agente
  /// do grupo de proposito: o prompt publico e o privado nao sao o mesmo.
  dmAgentId String? @map("dm_agent_id")
  dmAgent   Agent?  @relation("GroupDmAgent", fields: [dmAgentId], references: [id], onDelete: SetNull)

  participationMode ParticipationMode @default(mention) @map("participation_mode")
  keywords          String[]          @default([])
  groupInstructions String?           @map("group_instructions")
  cooldownSeconds   Int               @default(60) @map("cooldown_seconds")
  dailyMessageCap   Int               @default(50) @map("daily_message_cap")

  lastActivityAt DateTime? @map("last_activity_at")
  lastReplyAt    DateTime? @map("last_reply_at")
  /// ate onde o motor de decisao ja leu. Evita reprocessar as mesmas
  /// mensagens quando um novo bloco chega.
  lastProcessedMessageId BigInt? @map("last_processed_message_id")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages Message[]
  memory   GroupMemory?
  metrics  MetricDaily[]
  events   InstanceEvent[]
  /// pessoas que sairam deste grupo para o privado
  contacts Contact[] @relation("ContactOrigin")

  /// O ISOLAMENTO VIVE AQUI: mesmo JID em instancias diferentes = linhas diferentes
  @@unique([instanceId, remoteJid])
  @@index([instanceId, aiEnabled])
  @@index([instanceId, subject])
  @@map("groups")
}

model Message {
  id         BigInt   @id @default(autoincrement())
  instanceId String   @map("instance_id")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// Uma mensagem e de GRUPO ou de CONTATO, nunca dos dois. Manter as duas
  /// na mesma tabela preserva o unique (instance_id, evolution_key), que e o
  /// que protege de duplicata quando a Evolution reenvia eventos.
  groupId String? @map("group_id")
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// key.id da Evolution — base da idempotencia
  evoKey      String  @map("evolution_key")
  remoteJid   String  @map("remote_jid")
  participant String?
  pushName    String? @map("push_name")

  direction   String  // inbound | outbound
  content     String?
  messageType String? @map("message_type")
  isFromAi    Boolean @default(false) @map("is_from_ai")
  raw         Json?

  createdAt DateTime @default(now()) @map("created_at")

  /// ANTI-DUPLICATA: Evolution reenvia eventos em reconexao
  @@unique([instanceId, evoKey])
  @@index([instanceId, groupId, createdAt])
  @@index([instanceId, contactId, createdAt])
  @@map("messages")
}

/**
 * CONVERSA PRIVADA (1:1).
 *
 * Espelha o Group de proposito — mesma trava de isolamento, mesmo cooldown,
 * mesmo teto diario — porque o privado passa pelas mesmas filas e pelo mesmo
 * rate limit por numero que as respostas de grupo.
 *
 * Diferenca de politica: aqui a IA nasce LIGADA. No grupo, ninguem pediu para
 * a IA falar; no privado, a pessoa veio conversar. Deixar desligado por
 * padrao significaria alguem mandando mensagem e ninguem respondendo, que e
 * pior do que nao ter convidado.
 */
model Contact {
  id         String   @id @default(uuid())
  instanceId String   @map("instance_id")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// 5511...@s.whatsapp.net
  remoteJid   String  @map("remote_jid")
  phoneNumber String? @map("phone_number")
  pushName    String? @map("push_name")
  notes       String?

  /// De qual grupo esta pessoa saiu. E o que permite a IA comecar o privado
  /// sabendo do que se falava, em vez de a pessoa ter que repetir tudo.
  originGroupId String? @map("origin_group_id")
  originGroup   Group?  @relation("ContactOrigin", fields: [originGroupId], references: [id], onDelete: SetNull)

  /// escalated = veio de um grupo | inbound = chegou por conta propria
  origin String @default("inbound")

  agentId String? @map("agent_id")
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  aiEnabled Boolean @default(true) @map("ai_enabled")

  cooldownSeconds Int @default(15) @map("cooldown_seconds")
  dailyMessageCap Int @default(80) @map("daily_message_cap")

  lastActivityAt         DateTime? @map("last_activity_at")
  lastReplyAt            DateTime? @map("last_reply_at")
  lastProcessedMessageId BigInt?   @map("last_processed_message_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]

  /// mesmo ISOLAMENTO do Group: mesma pessoa em instancias diferentes = linhas diferentes
  @@unique([instanceId, remoteJid])
  @@index([instanceId, aiEnabled])
  @@index([instanceId, lastActivityAt])
  @@map("contacts")
}

model GroupMemory {
  groupId       String   @id @map("group_id")
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  summary       String?
  facts         Json     @default("[]")
  lastMessageId BigInt?  @map("last_message_id")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("group_memory")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model MetricDaily {
  id         BigInt   @id @default(autoincrement())
  instanceId String   @map("instance_id")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// null = agregado da instancia inteira
  groupId String? @map("group_id")
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// Chave de unicidade. Postgres nao trata NULL como igual a NULL, entao um
  /// unique com groupId nulo NAO impediria linhas duplicadas do agregado da
  /// instancia. groupKey guarda o groupId ou "-" e resolve isso.
  groupKey String @default("-") @map("group_key")

  day          DateTime @db.Date
  received     Int      @default(0)
  processed    Int      @default(0)
  ignoredByAi  Int      @default(0) @map("ignored_by_ai")
  repliesSent  Int      @default(0) @map("replies_sent")
  errors       Int      @default(0)
  latencySumMs BigInt   @default(0) @map("latency_sum_ms")
  latencyCount Int      @default(0) @map("latency_count")
  aiTokensIn   BigInt   @default(0) @map("ai_tokens_in")
  aiTokensOut  BigInt   @default(0) @map("ai_tokens_out")

  @@unique([instanceId, groupKey, day])
  @@index([instanceId, day])
  @@index([groupId, day])
  @@map("metrics_daily")
}

model InstanceEvent {
  id         BigInt   @id @default(autoincrement())
  instanceId String   @map("instance_id")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  groupId String? @map("group_id")
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  level     String // info | warn | error
  event     String // qr_generated | connected | disconnected | groups_synced | ...
  message   String?
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([instanceId, createdAt])
  @@index([level, createdAt])
  @@map("instance_events")
}

/// Configuracao global do aquecimento de chip. Linha unica (id = "default").
model WarmupConfig {
  id      String  @id @default("default")
  enabled Boolean @default(false)

  /// janela do dia em que o aquecimento acontece (hora local)
  startHour Int    @default(8) @map("start_hour")
  endHour   Int    @default(22) @map("end_hour")
  timezone  String @default("America/Sao_Paulo")

  /// intervalo entre mensagens de um mesmo numero
  /// intervalo para um numero INICIAR uma conversa nova
  minIntervalMinutes Int @default(25) @map("min_interval_minutes")
  maxIntervalMinutes Int @default(90) @map("max_interval_minutes")

  /// tempo que a pessoa leva para RESPONDER uma mensagem recebida.
  /// Bem menor que o de iniciar conversa: ninguem demora 1h para
  /// responder "ja almocou?" e ainda soar natural.
  replyMinMinutes Int @default(2) @map("reply_min_minutes")
  replyMaxMinutes Int @default(25) @map("reply_max_minutes")

  /// rampa: o teto diario sobe de `capStart` ate `capEnd` ao longo de N dias.
  /// Chip novo que dispara 30 mensagens no primeiro dia chama atencao.
  rampUpDays Int @default(21) @map("ramp_up_days")
  capStart   Int @default(4) @map("cap_start")
  capEnd     Int @default(30) @map("cap_end")

  model     String   @default("gpt-4o-mini")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warmup_config")
}

/// Uma conversa 1:1 entre dois numeros do painel.
model WarmupThread {
  id            String    @id @default(uuid())
  aInstanceId   String    @map("a_instance_id")
  bInstanceId   String    @map("b_instance_id")
  lastMessageAt DateTime? @map("last_message_at")
  messageCount  Int       @default(0) @map("message_count")
  createdAt     DateTime  @default(now()) @map("created_at")

  // TURNOS. Sem isto os dois numeros falam ao mesmo tempo e a resposta
  // chega antes da pergunta — foi o que aconteceu na primeira versao.
  /// quem falou por ultimo (nunca fala duas vezes seguidas)
  lastFromInstanceId String? @map("last_from_instance_id")
  /// de quem e a vez de falar
  nextTurnInstanceId String? @map("next_turn_instance_id")
  /// quando essa vez chega
  nextTurnAt         DateTime? @map("next_turn_at")

  messages WarmupMessage[]

  /// par ordenado (a < b) para nunca duplicar a mesma dupla
  @@unique([aInstanceId, bInstanceId])
  @@index([nextTurnAt])
  @@map("warmup_threads")
}

model WarmupMessage {
  id             BigInt       @id @default(autoincrement())
  threadId       String       @map("thread_id")
  thread         WarmupThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromInstanceId String       @map("from_instance_id")
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@index([fromInstanceId, createdAt])
  @@map("warmup_messages")
}

/// Eventos de webhook que nao casaram com nenhuma instancia.
/// Regra da spec: NUNCA processar mensagem sem identificar a instancia.
model OrphanEvent {
  id           BigInt   @id @default(autoincrement())
  evoName      String?  @map("evolution_name")
  event        String
  payload      Json
  receivedAt   DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("orphan_events")
}

/**
 * RODIZIO DE LINK (rotator).
 *
 * Um link publico que, a cada clique, manda o lead para um numero diferente.
 * E o que se usa em campanha: um unico link no anuncio, varios WhatsApp
 * atendendo.
 *
 * Os numeros sao DIGITADOS, nao escolhidos numa lista de instancias — assim
 * cabe celular de vendedor que nem passa pelo painel. Mas se o numero
 * digitado for igual ao de uma instancia, o painel amarra os dois sozinho
 * (ver instanceId), e ai passa a saber quando aquele numero caiu.
 */
model Rotator {
  id   String @id @default(uuid())
  name String
  /// pedaco final do link publico: /r/<slug>
  slug String @unique

  /// sequential = 1,2,3,1,2,3 (distribuicao exata) | random = sorteio
  strategy String @default("sequential")
  /// texto que ja vem digitado na conversa do lead
  message  String?

  isActive Boolean @default(true)
  /// pular numero desconectado e numero que o WhatsApp esta recusando
  skipUnhealthy Boolean @default(true)

  /// ponteiro do rodizio sequencial. Incremento atomico no banco: dois
  /// cliques ao mesmo tempo nunca caem no mesmo numero.
  cursor Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  destinations RotatorDestination[]
  clicks       RotatorClick[]

  @@map("rotators")
}

model RotatorDestination {
  id        String  @id @default(uuid())
  rotatorId String  @map("rotator_id")
  rotator   Rotator @relation(fields: [rotatorId], references: [id], onDelete: Cascade)

  label       String?
  /// so digitos, com DDI. Ex: 5511999999999
  phoneNumber String  @map("phone_number")

  /// preenchido quando este numero tambem e uma instancia do painel. E o
  /// unico jeito de saber se ele caiu — numero solto o painel nao enxerga.
  instanceId String?   @map("instance_id")
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  /// 0 = sem limite
  dailyCap Int @default(0) @map("daily_cap")
  totalCap Int @default(0) @map("total_cap")

  clicksToday Int       @default(0) @map("clicks_today")
  clicksTotal Int       @default(0) @map("clicks_total")
  /// dia a que clicksToday se refere; vira sozinho na virada
  dayRef      DateTime? @map("day_ref")
  lastClickAt DateTime? @map("last_click_at")

  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  clicks RotatorClick[]

  @@unique([rotatorId, phoneNumber])
  @@index([rotatorId, order])
  @@map("rotator_destinations")
}

model RotatorClick {
  id        BigInt  @id @default(autoincrement())
  rotatorId String  @map("rotator_id")
  rotator   Rotator @relation(fields: [rotatorId], references: [id], onDelete: Cascade)

  destinationId String?             @map("destination_id")
  destination   RotatorDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  phoneNumber String  @map("phone_number")
  /// ?src= do link, para separar origem de campanha
  source      String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rotatorId, createdAt])
  @@map("rotator_clicks")
}
